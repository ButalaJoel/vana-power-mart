# Copy to .env (development) or set in your hosting dashboard (production).
# Where the API runs
VITE_API_URL=http://localhost:4000
# Your live website address, no trailing slash (used for link previews)
VITE_SITE_URL=http://localhost:5173
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn analytics off.
VITE_GA_MEASUREMENT_ID=
