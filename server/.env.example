# Copy to server/.env and fill in. Never commit server/.env.

PORT=4000

# Database (Prisma Postgres): pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# Admin login. JWT_SECRET must be long and random (64+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Where the storefront and API live (used in SMS links and payment callbacks)
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# Allowed storefront origins, comma-separated (production: your real domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Mobile money
#   empty      = mobile money not offered (cash on delivery and bank transfer only)
#   simulator  = TEST MODE: payments complete by themselves, no real money
#   gateway    = live payments through your gateway
PAYMENT_PROVIDER=simulator
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-signature

# SMS through Africa's Talking (leave empty to log messages without sending)
# Use AT_USERNAME=sandbox with a sandbox API key for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
